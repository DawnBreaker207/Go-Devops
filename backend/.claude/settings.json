{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go fmt:*)",
      "Bash(go mod tidy)",
      "Bash(go mod download)",
      "Bash(go env:*)",
      "Bash(go version)",
      "Bash(gofmt:*)",
      "Bash(make help)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make tidy)",
      "Bash(make swag)",
      "Bash(make clean)",
      "Bash(swag init:*)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose up -d:*)",
      "Bash(docker ps:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Read(./.env.example)",
      "Bash(git -C * status)",
      "Bash(git -C * status:*)",
      "Bash(git -C * diff)",
      "Bash(git -C * diff:*)",
      "Bash(git -C * log)",
      "Bash(git -C * log:*)",
      "Bash(git -C * show:*)",
      "Bash(git -C * branch)",
      "Bash(git -C * branch:*)",
      "Bash(git -C * rev-parse:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(make run)",
      "Bash(go run:*)",
      "Bash(make migrate)",
      "Bash(make migrate:*)",
      "Bash(make migrate-up)",
      "Bash(make migrate-down)",
      "Bash(make migrate-seed)",
      "Bash(make migrate-create:*)",
      "Bash(make migrate-db-reset)",
      "Bash(make docker-up)",
      "Bash(make docker-down)",
      "Bash(make test-system)",
      "Bash(make test-race)",
      "Bash(make chaos)",
      "Bash(make test-load)",
      "Bash(make test-migrate)",
      "Bash(migrate:*)",
      "Bash(docker compose down:*)",
      "Bash(git -C * add:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * push:*)",
      "Bash(make migrate-create-seed:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env.local)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-after-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
