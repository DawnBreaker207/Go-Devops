# ============ APP ============
APP_NAME=BackEnd-CP
APP_ENV=development
APP_LOG_LEVEL=debug
# Admin account seeded while users table is empty (skipped in production)
APP_ADMIN_EMAIL=admin@cinema.local
APP_ADMIN_PASSWORD=admin123

# ============ SERVER ============
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# ============ DATABASE ============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cinema
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h
# The schema comes only from migrations/schema: run `make migrate-up`.

# ============ JWT ============
# REQUIRED. Generate random strings: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=backend-cp

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ RATE LIMIT ============
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_PER_SECOND=2
RATE_LIMIT_HOLD_CAPACITY=20
RATE_LIMIT_HOLD_REFILL_PER_SECOND=5

# ============ QUEUE (RabbitMQ) ============
# Docker: use amqp://guest:guest@rabbitmq:5672/
QUEUE_URL=amqp://guest:guest@localhost:5672/

# ============ BOOKING ============
BOOKING_HOLD_TTL_MINUTES=10
BOOKING_MAX_SEATS_PER_BOOKING=10

# ============ PAYMENT ============
PAYMENT_PUBLIC_BASE_URL=http://localhost:8080
PAYMENT_RETURN_REDIRECT_URL=
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_LATE_CAPTURE_WINDOW=24h
# mock provider (one option among providers)
PAYMENT_PROVIDERS_MOCK_ENABLED=true
PAYMENT_PROVIDERS_MOCK_SECRET=change_me_mock_secret

# ============ MAIL (mock mailer: writes .html files) ============
MAIL_OUTBOX_DIR=tmp/mail

# ============ LOGIN LOCKOUT ============
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_LOGIN_LOCKOUT=5m

# ============ AUDIT ============
AUDIT_RETENTION_DAYS=90

# ============ STORAGE (poster uploads) ============
# local | cloudinary
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
STORAGE_LOCAL_DIR=tmp/uploads
STORAGE_MAX_UPLOAD_MB=5
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_FOLDER=cinema
