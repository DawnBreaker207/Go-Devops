# ============ APP ============
APP_NAME=BackEnd-CP
APP_ENV=development
APP_LOG_LEVEL=debug
# Admin account seeded while users table is empty (skipped in production)
APP_ADMIN_EMAIL=admin@cinema.local
APP_ADMIN_PASSWORD=admin123

# ============ SERVER ============
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s

# ============ DATABASE ============
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cinema
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h
# true: use GORM AutoMigrate (dev). production: set false and run `make migrate-up`
DATABASE_AUTO_MIGRATE=true

# ============ JWT ============
# REQUIRED. Generate random strings: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=backend-cp

# ============ CORS ============
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============ RATE LIMIT ============
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_PER_SECOND=2
RATE_LIMIT_HOLD_CAPACITY=20
RATE_LIMIT_HOLD_REFILL_PER_SECOND=5

# ============ QUEUE (RabbitMQ) ============
# Docker: use amqp://guest:guest@rabbitmq:5672/
QUEUE_URL=amqp://guest:guest@localhost:5672/
