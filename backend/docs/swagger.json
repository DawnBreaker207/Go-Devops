                },
                "poster_url": {
                    "type": "string",
                    "maxLength": 512
                },
                "release_date": {
                    "type": "string",
                    "example": "2010-07-16"
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "showing",
                        "ended"
                    ],
                    "example": "showing"
                },
                "title": {
                    "type": "string",
                    "maxLength": 255,
