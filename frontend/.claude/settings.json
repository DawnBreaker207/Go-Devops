{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm run lint)",
      "Bash(npm run lint:fix)",
      "Bash(npm run build)",
      "Bash(npm run format)",
      "Bash(npm run preview)",
      "Bash(npm test)",
      "Bash(npm ls:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vitest run:*)",
      "Bash(node -v)",
      "Bash(npm -v)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git blame:*)",
      "Bash(git remote -v)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(rg:*)",
      "Bash(jq:*)",
      "Bash(wc:*)",
      "Read(./.env.example)",
      "Bash(git -C * status)",
      "Bash(git -C * status:*)",
      "Bash(git -C * diff)",
      "Bash(git -C * diff:*)",
      "Bash(git -C * log)",
      "Bash(git -C * log:*)",
      "Bash(git -C * show:*)",
      "Bash(git -C * branch)",
      "Bash(git -C * branch:*)",
      "Bash(git -C * rev-parse:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm run dev)",
      "Bash(npm run test:watch)",
      "Bash(npm uninstall:*)",
      "Bash(npm update:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(git -C * add:*)",
      "Bash(git -C * commit:*)",
      "Bash(git -C * push:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(npm publish:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.*.local)",
      "Read(**/*.pem)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env.local)",
      "Read(//Users/juan/Documents/DicomSource/CinemaProject/**/.env.production)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/format-after-edit.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
