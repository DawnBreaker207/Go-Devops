# Template at root, next to docker-compose.yml.
# Compose: cp .env.example .env (root). `make run`: cp .env.example backend/.env.
# ============ APP ============
APP_NAME=BackEnd-CP
# development: local. production: refuses empty/dev secrets.
APP_ENV=development
APP_LOG_LEVEL=debug
# Admin account seeded while users table is empty (skipped in production)
APP_ADMIN_EMAIL=admin@cinema.local
APP_ADMIN_PASSWORD=admin123

# ============ SERVER ============
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_SHUTDOWN_TIMEOUT=10s
SERVER_READ_HEADER_TIMEOUT=5s
SERVER_IDLE_TIMEOUT=60s
# Largest JSON request body in bytes (uploads have their own limit).
SERVER_MAX_BODY_BYTES=1048576
# Proxies trusted with X-Forwarded-For; empty = use direct TCP peer IP.
SERVER_TRUSTED_PROXIES=

# ============ DATABASE ============
# Compose ignores this (pins postgres); only `make run` uses it.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=cinema
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=Asia/Ho_Chi_Minh
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=1h
# The schema comes only from migrations/schema: run `make migrate-up`.

# ============ JWT ============
# REQUIRED. Generate random strings: openssl rand -hex 32
JWT_ACCESS_SECRET=change_me_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_at_least_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h
JWT_ISSUER=backend-cp

# ============ CORS ============
CORS_ALLOWED_ORIGINS=https://<hostname>

# ============ RATE LIMIT ============
RATE_LIMIT_AUTH_CAPACITY=10
RATE_LIMIT_AUTH_REFILL_PER_SECOND=2
RATE_LIMIT_HOLD_CAPACITY=20
RATE_LIMIT_HOLD_REFILL_PER_SECOND=5
RATE_LIMIT_PUBLIC_CAPACITY=60
RATE_LIMIT_PUBLIC_REFILL_PER_SECOND=20
RATE_LIMIT_EVENTS_CAPACITY=10
RATE_LIMIT_EVENTS_REFILL_PER_SECOND=0.2

# ============ QUEUE (RabbitMQ) ============
# Compose ignores this (pins rabbitmq); only `make run` uses it.
QUEUE_URL=amqp://guest:guest@rabbitmq:5672/

# ============ REDIS (optional read cache) ============
# Leave REDIS_ADDR empty to run without caching (`make run`).
# Compose pins redis:6379.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=5m

# ============ BOOKING ============
BOOKING_HOLD_TTL_MINUTES=10
BOOKING_MAX_SEATS_PER_BOOKING=10
BOOKING_HOLD_MAX_LIFETIME_MINUTES=15

# ============ CHECK-IN ============
CHECKIN_OPEN_BEFORE_MINUTES=30
CHECKIN_CLOSE_AFTER_MINUTES=20

# ============ PAYMENT ============
PAYMENT_PUBLIC_BASE_URL=https://<hostname>
# Empty = customer lands on raw JSON after paying instead of the site.
PAYMENT_RETURN_REDIRECT_URL=https://<hostname>/payment-result
PAYMENT_DEFAULT_PROVIDER=mock
PAYMENT_LATE_CAPTURE_WINDOW=24h
# mock provider (collects no real money; needs explicit allow in production)
PAYMENT_PROVIDERS_MOCK_ENABLED=true
PAYMENT_PROVIDERS_MOCK_SECRET=change_me_mock_secret
PAYMENT_PROVIDERS_MOCK_ALLOW_IN_PRODUCTION=false

# ============ MAIL (mock mailer: writes .html files) ============
MAIL_OUTBOX_DIR=tmp/mail

# ============ ACCOUNT (self-service) ============
# Frontend page taking ?token= for password reset.
ACCOUNT_PASSWORD_RESET_URL=https://<hostname>/reset-password
# Reset token lifetime, between 5m and 24h.
ACCOUNT_PASSWORD_RESET_TTL=30m
ACCOUNT_TERMS_VERSION=1

# ============ LOGIN LOCKOUT ============
RATE_LIMIT_LOGIN_MAX_FAILURES=5
RATE_LIMIT_LOGIN_LOCKOUT=5m

# ============ AUDIT ============
AUDIT_RETENTION_DAYS=90

# ============ STORAGE (poster uploads) ============
# local | cloudinary
STORAGE_DRIVER=local
STORAGE_PUBLIC_BASE_URL=https://<hostname>
STORAGE_LOCAL_DIR=tmp/uploads
STORAGE_MAX_UPLOAD_MB=5
STORAGE_CLOUDINARY_CLOUD_NAME=
STORAGE_CLOUDINARY_API_KEY=
STORAGE_CLOUDINARY_API_SECRET=
STORAGE_CLOUDINARY_FOLDER=cinema

# ============ COMPOSE (root docker-compose.yml) ============
# Published ports: change when the defaults are taken (shared VM, parallel tests).
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
BACKEND_PORT=8080
FRONTEND_PORT=80
REGISTRY_PORT=5000
# Public API URL, baked into frontend at build.
VITE_API_BASE_URL=https://<hostname>/api/v1

# ============ CI (self-hosted runner only) ============
# Throwaway test services on odd ports so CI never clashes with the dev stack.
# Copy these into the ENV_FILE secret as well; compose ignores them.
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
TEST_REDIS_ADDR=localhost:6380
QUEUE_TEST_URL=amqp://guest:guest@localhost:5673/
